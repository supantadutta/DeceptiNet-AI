# DeceptiNet-AI environment overrides (copy to .env; never commit a real .env).
#
# These override the matching keys in config.yaml. They exist so Docker and the
# (future) experiment runner can flip the experimental switches without editing
# files. Unset variables fall back to config.yaml.

# Path to the config file (default: ./config.yaml)
# DECEPTINET_CONFIG=config.yaml

# THE experimental switch. Phase 1 only supports "vanilla".
# DECEPTINET_MODE=vanilla

# Experiment identifier stamped onto every captured session.
# DECEPTINET_EXPERIMENT_ID=exp-001

# Datastore URL. SQLite for local; Postgres in Docker.
#   sqlite:///data/deceptinet.sqlite3
#   postgresql://deceptinet:deceptinet@db:5432/deceptinet
# DECEPTINET_DATASTORE_URL=sqlite:///data/deceptinet.sqlite3

# LLM provider (Phase 2): "claude" | "ollama" | "openai_compat" | "static".
# DECEPTINET_LLM_PROVIDER=static

# Claude API key — read automatically by the Anthropic SDK when provider=claude.
# Note: reaching api.anthropic.com requires outbound egress, which the default
# -deny Docker network blocks. Use a local Ollama provider for the contained
# stack (see docker-compose.llm.yml), or run bare-metal.
# ANTHROPIC_API_KEY=sk-ant-...

# For ollama / openai_compat, set the endpoint in config.yaml (llm.base_url),
# e.g. http://ollama:11434 or http://vllm:8000/v1

# SSH listener overrides.
# DECEPTINET_SSH_LISTEN=0.0.0.0:2222
# DECEPTINET_SSH_ENABLED=true

# Health/dashboard endpoint.
# DECEPTINET_HEALTH_LISTEN=0.0.0.0:8000

# Containment.
# DECEPTINET_EGRESS=deny
# DECEPTINET_KILL_SWITCH_FILE=/run/deceptinet.stop

# Where SSH host keys are stored (generated on first run if absent).
# DECEPTINET_HOSTKEY_DIR=data/hostkeys

# Logging level.
# DECEPTINET_LOG_LEVEL=INFO
